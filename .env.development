# Development: empty base URL, so the app calls same-origin paths like
# /api/v1/health and Vite's proxy (vite.config.ts) forwards them to the local
# backend. Nothing here is a secret — Vite inlines every VITE_* value into the
# bundle, so anything in this file is public by definition.
VITE_API_URL=

# Where the dev proxy forwards. Point it at a deployed API to run the local
# front end against it.
VITE_DEV_API_TARGET=http://localhost:4000

# Same default locally, so dev matches what ships.
VITE_ENABLE_FACEBOOK_AUTH=false
