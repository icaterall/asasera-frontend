# Copy to .env.local to override for your machine.
#
# WARNING: every VITE_* variable is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put an API key, a database URL, or any secret here.

# Base URL of the API. Empty in development so calls go same-origin through
# the Vite proxy; a full origin in production.
VITE_API_URL=

# Where the dev proxy forwards /api. Defaults to http://localhost:4000.
VITE_DEV_API_TARGET=http://localhost:4000
