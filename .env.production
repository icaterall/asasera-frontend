# Production. Baked into the bundle at BUILD time — Vite inlines VITE_* values,
# there is no runtime lookup, so changing this needs a rebuild and redeploy.
#
# The API lives on its own host, so production calls are genuinely
# cross-origin: the backend's CORS_ORIGINS must list this front end's origin,
# and every request sends credentials so the httpOnly refresh cookie travels.
VITE_API_URL=https://backend.asasera.com

# Facebook sign-in stays hidden in production until Meta approves the app.
# Restated here rather than inherited from .env so a production build cannot
# switch it on by accident. Backend Facebook code is untouched.
VITE_ENABLE_FACEBOOK_AUTH=false
