# Loaded in every mode. Vite inlines VITE_* into the bundle at build time, so
# nothing here is a secret — these are public by definition.

# Facebook sign-in is hidden while the Meta app is in review.
#
# This gates the BUTTON ONLY. The backend route, the `facebook` value in the
# user_identities provider CHECK, the signed_request deletion callback and the
# privacy-policy text all stay exactly as they are — the Meta submission
# depends on every one of them, and the reviewer follows the policy text to
# the callback. Flip this to true to show the button again; no component
# change is needed.
VITE_ENABLE_FACEBOOK_AUTH=false
