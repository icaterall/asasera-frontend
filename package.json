{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:media && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test:login-return": "node --test tests/login-return.test.ts",
    "check:k8s": "node scripts/check-k8s.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "assert:build": "node scripts/assert-build.mjs",
    "postbuild": "npm run assert:build",
    "smoke": "node scripts/smoke.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "check:media": "node scripts/check-media-policy.mjs",
    "test:media": "node --test tests/media-policy.test.ts && vitest run tests/audio.spec.tsx",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:student-learning": "node --test tests/student-learning.test.ts",
    "test:dropdowns": "vitest run tests/dropdowns.spec.tsx",
    "test:education-stages": "node --test tests/student-learning.test.ts && vitest run tests/education-stages.spec.tsx tests/audience.spec.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/montserrat": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "canvas-confetti": "^1.9.4",
    "howler": "^2.2.4",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.40.0",
    "mathlive": "^0.110.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
